{
  "openapi": "3.0.3",
  "info": {
    "title": "API de reportes",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8081",
      "description": "Docker Compose local"
    }
  ],
  "paths": {
    "/reports/events": {
      "get": {
        "tags": [
          "Reportes"
        ],
        "operationId": "listEvents",
        "summary": "Listar eventos publicados",
        "description": "Consulta el catálogo de la API de venta de entradas.",
        "responses": {
          "200": {
            "description": "Solicitud completada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventList"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/Unavailable"
          },
          "504": {
            "$ref": "#/components/responses/Timeout"
          }
        }
      }
    },
    "/reports/events/{eventId}/sales": {
      "get": {
        "tags": [
          "Reportes"
        ],
        "operationId": "getEventSales",
        "summary": "Consultar ventas confirmadas de un evento",
        "description": "Requiere un token Bearer de una cuenta con rol de administrador. La API de venta de entradas valida el token.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1,
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Solicitud completada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventSales"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "502": {
            "$ref": "#/components/responses/Unavailable"
          },
          "504": {
            "$ref": "#/components/responses/Timeout"
          }
        }
      }
    },
    "/reports/sales/summary": {
      "get": {
        "tags": [
          "Reportes"
        ],
        "operationId": "getSalesSummary",
        "summary": "Consultar el resumen de ventas confirmadas",
        "description": "Requiere un token Bearer de una cuenta con rol de administrador. La API de venta de entradas valida el token.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Solicitud completada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SalesSummary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "502": {
            "$ref": "#/components/responses/Unavailable"
          },
          "504": {
            "$ref": "#/components/responses/Timeout"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token de acceso obtenido en POST /auth/login de la API de venta de entradas."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Event": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "event_date",
          "total_tickets",
          "ticket_price",
          "available_tickets",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Concierto de verano"
          },
          "description": {
            "type": "string",
            "example": "Evento de prueba"
          },
          "event_date": {
            "type": "string",
            "example": "2027-06-15 23:30:00+00",
            "description": "Fecha y hora con zona horaria devuelta por PostgreSQL."
          },
          "total_tickets": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "example": 120
          },
          "ticket_price": {
            "type": "string",
            "example": "1500.00",
            "pattern": "^[0-9]+\\.[0-9]{2}$"
          },
          "available_tickets": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "example": 118
          },
          "status": {
            "type": "string",
            "example": "published",
            "enum": [
              "draft",
              "published",
              "cancelled"
            ]
          }
        }
      },
      "EventList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          }
        }
      },
      "SalesSummary": {
        "type": "object",
        "required": [
          "purchase_count",
          "tickets_sold",
          "total_revenue"
        ],
        "properties": {
          "purchase_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "example": 1
          },
          "tickets_sold": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "example": 2
          },
          "total_revenue": {
            "type": "string",
            "example": "3000.00",
            "pattern": "^[0-9]+\\.[0-9]{2}$"
          }
        }
      },
      "EventSales": {
        "type": "object",
        "required": [
          "event_id",
          "event_name",
          "purchase_count",
          "tickets_sold",
          "total_revenue"
        ],
        "properties": {
          "event_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "example": 1
          },
          "event_name": {
            "type": "string",
            "example": "Concierto de verano"
          },
          "purchase_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "example": 1
          },
          "tickets_sold": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "example": 2
          },
          "total_revenue": {
            "type": "string",
            "example": "3000.00",
            "pattern": "^[0-9]+\\.[0-9]{2}$"
          }
        }
      }
    },
    "responses": {
      "Forbidden": {
        "description": "Se requiere el rol de administrador.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Se requieren permisos de administrador."
            }
          }
        }
      },
      "NotFound": {
        "description": "Evento no encontrado.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Evento no encontrado."
            }
          }
        }
      },
      "Timeout": {
        "description": "La API de venta de entradas no respondió a tiempo.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "El servicio principal tardó demasiado en responder."
            }
          }
        }
      },
      "Unauthorized": {
        "description": "El token falta, es inválido o ha expirado.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Se requiere autenticación."
            }
          }
        },
        "headers": {
          "WWW-Authenticate": {
            "description": "Tipo de autenticación requerido.",
            "schema": {
              "type": "string",
              "example": "Bearer"
            }
          }
        }
      },
      "Unavailable": {
        "description": "La API de venta de entradas no pudo completar la consulta.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
